# Public DNS hostname you control; no https:// prefix here.
AV_HOST=vault.example.com
# Linux host user/group owning data, secrets, and recovery directories.
AV_UID=1000
AV_GID=1000
# Production: pre-mounted independent disk/NAS. Same-disk folder is development only.
RECOVERY_PATH=./recovery
# Obtain your own application credentials at https://my.telegram.org.
# Keep this file private; never commit the real .env.
TG_API_ID=
TG_API_HASH=
